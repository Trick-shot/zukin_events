# Generate a fresh one per environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite in dev. Point this at a postgres:// URL to switch databases without
# touching settings.py — django-environ parses both forms.
DATABASE_URL=sqlite:///db.sqlite3

# Origins allowed to call the API from a browser (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
